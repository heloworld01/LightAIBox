/* ============================================
   LightAIBox · Dark Theme
   ============================================ */

/* === 全局 === */
QWidget {
    background-color: #0E1117;
    color: #E9ECF2;
    font-family: "Inter", "SF Pro Text", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* === 主窗口圆角（配合 WA_TranslucentBackground 透明背景） === */
QMainWindow {
    background: transparent;
}
QMainWindow > QWidget#centralWrap {
    background: #0E1117;
    border: 1px solid #2B3245;
    border-radius: 12px;
}

/* === QTabWidget === */
QTabWidget::pane {
    border: none;
    background: #161B26;
    /* 底部圆角与主窗口 centralWrap 对齐，避免方角盖住窗口圆角 */
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}
QTabBar {
    background: #0E1117;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #2B3245;
}
QTabBar::tab {
    background: transparent;
    color: #9BA3B5;
    padding: 10px 24px;
    margin-right: 2px;
    font-size: 13px;
    font-weight: 500;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #E9ECF2;
    border-bottom-color: #6366F1;
}
QTabBar::tab:hover:!selected {
    color: #E9ECF2;
    background: #252D3D;
    border-radius: 6px 6px 0 0;
}

/* === QTableWidget === */
QTableWidget {
    background: #161B26;
    alternate-background-color: transparent;
    border: 1px solid #2B3245;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #3A4268;
    selection-color: #E9ECF2;
    outline: none;
}
QTableWidget::item {
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #2B3245;
}
QTableWidget::item:hover {
    background: #252D3D;
}
QTableWidget::item:selected {
    background: #3A4268;
    color: #FFFFFF;
}
QHeaderView::section {
    background: #1E2433;
    color: #9BA3B5;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #2B3245;
}

/* === 按钮体系 === */
QPushButton[class="primary"] {
    background: #6366F1;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
    font-size: 13px;
}
QPushButton[class="primary"]:hover {
    background: #818CF8;
}
QPushButton[class="primary"]:pressed {
    background: #4F46E5;
}
QPushButton[class="primary"]:disabled {
    background: #1E2433;
    color: #5C6478;
}

QPushButton[class="secondary"] {
    background: #1E2433;
    color: #E9ECF2;
    border: 1px solid #2B3245;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
}
QPushButton[class="secondary"]:hover {
    background: #252D3D;
    border-color: #3D4560;
}
QPushButton[class="secondary"]:disabled {
    color: #5C6478;
}

QPushButton[class="danger"] {
    background: rgba(248,113,113,0.10);
    color: #F87171;
    border: 1px solid rgba(248,113,113,0.30);
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
}
QPushButton[class="danger"]:hover {
    background: rgba(248,113,113,0.20);
}
QPushButton[class="danger"]:disabled {
    background: #1E2433;
    color: #5C6478;
    border-color: #2B3245;
}

QPushButton[class="ghost"] {
    background: transparent;
    color: #9BA3B5;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
}
QPushButton[class="ghost"]:hover {
    background: #252D3D;
    color: #E9ECF2;
}
QPushButton[class="ghost"]:disabled {
    color: #5C6478;
}

QPushButton[class="success"] {
    background: #34D399;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
    font-size: 13px;
}
QPushButton[class="success"]:hover {
    background: #4ADE80;
}
QPushButton[class="success"]:pressed {
    background: #10B981;
}
QPushButton[class="success"]:disabled {
    background: #1E2433;
    color: #5C6478;
}

/* === 输入控件 === */
QLineEdit, QSpinBox, QComboBox {
    background: #1E2433;
    border: 1px solid #2B3245;
    border-radius: 6px;
    padding: 6px 10px;
    color: #E9ECF2;
    font-size: 13px;
    min-height: 20px;
}
QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
    border-color: #3D4560;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #6366F1;
}
QLineEdit::placeholder {
    color: #5C6478;
}
QLineEdit:read-only {
    background: #161B26;
    color: #9BA3B5;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    background: #161B26;
    color: #5C6478;
    border-color: #2B3245;
}

/* === QComboBox 下拉 === */
QComboBox::drop-down {
    border: none;
    width: 24px;
    subcontrol-position: center right;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9BA3B5;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: #1E2433;
    border: 1px solid #2B3245;
    border-radius: 6px;
    selection-background-color: #2A3347;
    selection-color: #E9ECF2;
    outline: none;
    padding: 4px;
}

/* === QSpinBox 箭头 === */
QSpinBox::up-button, QSpinBox::down-button {
    background: #1E2433;
    border: none;
    width: 20px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #252D3D;
}

/* === QCheckBox === */
QCheckBox {
    spacing: 8px;
    color: #E9ECF2;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2B3245;
    border-radius: 4px;
    background: #1E2433;
}
QCheckBox::indicator:hover {
    border-color: #6366F1;
}
QCheckBox::indicator:checked {
    background: #6366F1;
    border-color: #6366F1;
    image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path d='M3.5 8.5l3 3 6-6' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
}

/* === QScrollBar === */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2B3245;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5C6478;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2B3245;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #5C6478;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* === QToolTip === */
QToolTip {
    background: #1E2433;
    color: #E9ECF2;
    border: 1px solid #2B3245;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === QSplitter === */
QSplitter::handle {
    background: #0E1117;
}
QSplitter::handle:vertical {
    height: 6px;
}
QSplitter::handle:horizontal {
    width: 6px;
}
QSplitter::handle:hover {
    background: #6366F1;
    border-radius: 3px;
}

/* === QFrame 面板 === */
QFrame[class="panel"] {
    background: #161B26;
    border: 1px solid #2B3245;
    border-radius: 8px;
}

/* === SectionHeader 分割线 === */
QFrame[class="section-divider"] {
    background: #2B3245;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* === StatusBadge 状态胶囊 === */
QLabel[class="status-badge"] {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[class="status-badge-success"] {
    background: rgba(52,211,153,0.10);
    color: #34D399;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[class="status-badge-warning"] {
    background: rgba(251,191,36,0.10);
    color: #FBBF24;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[class="status-badge-danger"] {
    background: rgba(248,113,113,0.10);
    color: #F87171;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel[class="status-badge-neutral"] {
    background: rgba(107,114,128,0.10);
    color: #6B7280;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* === 行内操作按钮（表格 cellWidget） === */
QPushButton[class="row-action"] {
    background: #1E2433;
    border: 1px solid #2B3245;
    color: #9BA3B5;
    border-radius: 4px;
    padding: 0px 10px;
    font-size: 12px;
    min-height: 26px;
}
QPushButton[class="row-action"]:hover {
    background: #6366F1;
    color: #FFFFFF;
    border-color: #6366F1;
}
QPushButton[class="row-action"]:disabled {
    color: #5C6478;
}
QPushButton[class="row-action-success"] {
    background: rgba(52,211,153,0.10);
    border: 1px solid rgba(52,211,153,0.30);
    color: #34D399;
    border-radius: 4px;
    padding: 0px 10px;
    font-size: 12px;
    min-height: 26px;
}
QPushButton[class="row-action-danger"] {
    background: rgba(248,113,113,0.10);
    border: 1px solid rgba(248,113,113,0.30);
    color: #F87171;
    border-radius: 4px;
    padding: 0px 10px;
    font-size: 12px;
    min-height: 26px;
}

/* === 工具栏竖分隔线 === */
QFrame[class="v-separator"] {
    background: #2B3245;
    border: none;
    min-width: 1px;
    max-width: 1px;
}

/* === 区块标题文字 === */
QLabel[class="section-title"] {
    color: #E9ECF2;
    font-size: 15px;
    font-weight: 600;
}

/* === 说明文字 === */
QLabel[class="explain-text"] {
    color: #9BA3B5;
    font-size: 13px;
}
QLabel[class="stats-text"] {
    color: #9BA3B5;
    font-size: 12px;
}

/* === QMessageBox === */
QMessageBox {
    background: #161B26;
}
QMessageBox QLabel {
    color: #E9ECF2;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* === QDialog === */
QDialog {
    background: #161B26;
}

/* === 无边框圆角对话框（ProviderDialog） === */
QFrame[class="dialog-card"] {
    background: #161B26;
    border: 1px solid #2B3245;
    border-radius: 12px;
}
QFrame[class="dialog-header"] {
    background: #1E2433;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #2B3245;
}
QLabel[class="dialog-title"] {
    color: #E9ECF2;
    font-size: 14px;
    font-weight: 600;
}

/* === 自定义消息框（MessageBox）内容 === */
QLabel[class="msg-icon"] {
    color: #6366F1;
    font-size: 20px;
}
QLabel[class="msg-text"] {
    color: #E9ECF2;
    font-size: 13px;
}

/* === 兜底 QGroupBox（正常不应使用） === */
QGroupBox {
    border: 1px solid #2B3245;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 500;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #E9ECF2;
}